{
  "version": 2,
  "backends": [
    {
      "id": "artbird",
      "type": "hypeman",
      "connectionFile": "~/.config/agentbrowse/hosts/artbird.json",
      "cpus": 2,
      "memory": "3G",
      "portOffset": 2000,
      "video": {
        "fps": 60,
        "targetBitrateBps": 4792320,
        "keyframeMaxDistance": 60
      }
    },
    {
      "id": "local",
      "type": "hypeman",
      "connectionFile": "~/.config/agentbrowse/hosts/local.json",
      "cpus": 2,
      "memory": "3G",
      "portOffset": 2000
    }
  ],
  "images": {
    "defaultImage": "docker.io/onkernel/chromium-headful@sha256:da9ee68cb9d2de0b3c26885ff3bdcf04c944254a36eb127219028ac017ff56f3"
  },
  "browser": {
    "nekoLogLevel": "info",
    "timezone": "America/New_York",
    "video": {
      "screenRefreshRate": 60,
      "fps": 30,
      "cpuUsed": 4,
      "threads": 4,
      "targetBitrateBps": 2396160,
      "keyframeMaxDistance": 30
    }
  },
  "provider": {
    "name": "agentbrowse",
    "description": "Manage ordered Kernel browser backends"
  },
  "liveView": {
    "labelPrefix": "agentbrowse",
    "username": "kernel",
    "password": "admin",
    "readOnly": false
  },
  "discovery": {
    "commandTimeoutMs": 2000
  }
}
