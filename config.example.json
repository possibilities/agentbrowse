{
  "version": 2,
  "backends": [
    {
      "id": "remote-docker",
      "type": "docker",
      "context": "remote-browser",
      "expectedEndpoint": "ssh://browser-host",
      "expectedEngine": "browser-host",
      "remoteHost": "browser-host",
      "networkAddress": "192.0.2.10"
    },
    {
      "id": "apple-container-local",
      "type": "apple-container",
      "command": "/usr/local/bin/container",
      "maxTargets": 1,
      "cpus": 2,
      "memory": "6G"
    }
  ],
  "images": {
    "defaultImage": "docker.io/onkernel/chromium-headful@sha256:da9ee68cb9d2de0b3c26885ff3bdcf04c944254a36eb127219028ac017ff56f3"
  },
  "browser": {
    "nekoLogLevel": "info",
    "timezone": "UTC"
  },
  "provider": {
    "name": "agentbrowse",
    "description": "Manage ordered Kernel browser backends"
  },
  "liveView": {
    "labelPrefix": "agentbrowse",
    "username": "kernel",
    "password": "admin",
    "readOnly": false
  },
  "discovery": {
    "commandTimeoutMs": 2000
  }
}
