#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly ROOT_DIR
readonly VERSION="144.7559.14"
readonly ARCHIVE_NAME="LiveKitWebRTC.xcframework.zip"
readonly EXPECTED_SHA256="4b0a4be4564aa05168a02f262bbbc4d6d9a552aaa1c102229ed5adf1c480b81a"
readonly URL="https://github.com/livekit/webrtc-xcframework/releases/download/${VERSION}/${ARCHIVE_NAME}"
readonly DEPS_DIR="${ROOT_DIR}/.deps"
readonly ARCHIVE_PATH="${DEPS_DIR}/${ARCHIVE_NAME}"
readonly PART_PATH="${ARCHIVE_PATH}.part"
readonly FRAMEWORK_PATH="${DEPS_DIR}/LiveKitWebRTC.xcframework"

if [[ -d "$FRAMEWORK_PATH" ]]; then
  printf 'LiveKitWebRTC %s is already available at %s\n' "$VERSION" "$FRAMEWORK_PATH"
  exit 0
fi

for required in curl shasum unzip; do
  command -v "$required" >/dev/null 2>&1 || {
    printf 'fetch-webrtc: required command not found: %s\n' "$required" >&2
    exit 1
  }
done

mkdir -p "$DEPS_DIR"
printf 'Downloading LiveKitWebRTC %s (%s bytes)\n' "$VERSION" "66609446"
curl --fail --location --show-error --output "$PART_PATH" "$URL"

actual_sha256="$(shasum -a 256 "$PART_PATH" | awk '{print $1}')"
if [[ "$actual_sha256" != "$EXPECTED_SHA256" ]]; then
  printf 'fetch-webrtc: checksum mismatch: expected %s, got %s\n' \
    "$EXPECTED_SHA256" "$actual_sha256" >&2
  exit 1
fi

mv "$PART_PATH" "$ARCHIVE_PATH"
unzip -q "$ARCHIVE_PATH" -d "$DEPS_DIR"
printf 'Verified and extracted %s\n' "$FRAMEWORK_PATH"
