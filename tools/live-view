#!/usr/bin/env bun

import { existsSync } from "node:fs";
import { join } from "node:path";

import { browserFarm } from "../cli/runtime.ts";
import { connectionDescriptor } from "../client/connection.ts";
import { liveViewBuildPrefix } from "../client/live-view-build.ts";
import { LiveViewTunnel } from "../client/tunnel.ts";
import { loadAgentbrowseConfig } from "../config/deployment.ts";

const buildPrefix = liveViewBuildPrefix(join(import.meta.dir, "..", "zig-out"));
const appExecutable = join(
  buildPrefix,
  "Kernel Live View.app",
  "Contents",
  "MacOS",
  "kernel-live-view",
);

function usage(): never {
  process.stderr.write(`Usage: tools/live-view <command> NAME

Commands:
  status NAME      Show the backend, container, and access state.
  descriptor NAME  Emit its connection descriptor as JSON.
  launch NAME      Open the configured access and run the AppKit app.
`);
  process.exit(2);
}

async function targetNamed(name: string) {
  const target = (await browserFarm().list()).find((entry) => entry.name === name);
  if (target === undefined) throw new Error(`unknown Browser target: ${name}`);
  return target;
}

async function withAccess<T>(
  name: string,
  operation: (descriptor: ReturnType<typeof connectionDescriptor>) => Promise<T>,
): Promise<T> {
  const target = await targetNamed(name);
  if (target.state !== "running") throw new Error(`${target.container} is not running`);
  const access = await LiveViewTunnel.open(target);
  try {
    const config = loadAgentbrowseConfig().liveView;
    return await operation(
      connectionDescriptor(target, access.baseUrl, {
        labelPrefix: config.labelPrefix,
        username: config.username,
        password: config.password,
        readOnly: config.readOnly,
      }),
    );
  } finally {
    await access.close();
  }
}

async function main(argv: readonly string[]): Promise<number> {
  const [command, name, extra] = argv;
  if (command === undefined || name === undefined || extra !== undefined) usage();
  if (!/^[a-z][a-z0-9-]{0,31}$/.test(name)) throw new Error(`invalid Browser target: ${name}`);

  if (command === "status") {
    const target = await targetNamed(name);
    process.stdout.write(
      `${target.name}\t${target.backend}\t${target.container}\t${target.state}\t${target.liveViewUrl}\n`,
    );
    return 0;
  }
  if (command === "descriptor") {
    return await withAccess(name, async (descriptor) => {
      process.stdout.write(`${JSON.stringify(descriptor)}\n`);
      return 0;
    });
  }
  if (command === "launch") {
    if (!existsSync(appExecutable)) {
      throw new Error(`app is not built under ${buildPrefix}; run 'bun run native:build:app'`);
    }
    return await withAccess(name, async (descriptor) => {
      const child = Bun.spawn([appExecutable, "--connection-stdin"], {
        env: process.env,
        stdin: "pipe",
        stdout: "inherit",
        stderr: "inherit",
      });
      child.stdin.write(JSON.stringify(descriptor));
      child.stdin.end();
      return await child.exited;
    });
  }
  usage();
}

try {
  process.exit(await main(process.argv.slice(2)));
} catch (error) {
  process.stderr.write(`live-view: ${error instanceof Error ? error.message : String(error)}\n`);
  process.exit(1);
}
