#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly ROOT_DIR
readonly DOCKER_CONTEXT="${AGENTBROWSE_DOCKER_CONTEXT:-artbird}"
readonly REMOTE_HOST="${AGENTBROWSE_REMOTE_HOST:-artbird}"
readonly SOURCE_DIR="${AGENTBROWSE_KERNEL_IMAGES:-${HOME:?}/src/kernel-images}"
readonly RUNTIME_DIR="${AGENTBROWSE_RUNTIME_DIR:-${TMPDIR:-/tmp}/agentbrowse-live-view-${UID}}"
readonly APP_EXECUTABLE="${ROOT_DIR}/zig-out/Kernel Live View.app/Contents/MacOS/kernel-live-view"
readonly NEKO_LOG_LEVEL="${AGENTBROWSE_NEKO_LOG_LEVEL:-info}"

NAME=""
CONTAINER=""
HTTP_PORT=""
WEBRTC_PORT=""

die() {
  printf 'live-view: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: tools/live-view <command> [name] [slot]

Commands:
  start [name] [slot]  Start a named local Kernel/Neko browser.
  status [name]        Show its container and service state.
  tunnel [name]        Keep its loopback HTTP/WebSocket tunnel open.
  descriptor [name]    Emit its connection descriptor as JSON.
  launch [name]        Pipe its descriptor into the built AppKit executable.
  stop [name]          Stop its container without deleting it.
  destroy [name]       Delete its exact container and generated target config.

Names contain lowercase letters, digits, and hyphens. Slot 0 uses local TCP
port 18080 and WebRTC UDP port 56000; each additional slot increments both.
The default name is "local" and the default slot is 0.
EOF
}

validate_name() {
  [[ "$1" =~ ^[a-z][a-z0-9-]{0,31}$ ]] ||
    die "name must match [a-z][a-z0-9-]{0,31}: $1"
}

validate_slot() {
  [[ "$1" =~ ^[0-9]{1,3}$ ]] || die "slot must be an integer from 0 to 999: $1"
  (( 18080 + 10#$1 <= 65535 && 56000 + 10#$1 <= 65535 )) || die "slot is out of port range: $1"
}

config_path() {
  printf '%s/%s.env\n' "$RUNTIME_DIR" "$1"
}

write_config() {
  local name="$1" slot="$2" container
  if [[ "$name" == local && "$slot" == 0 ]]; then
    container="agentbrowse-kernel-live-view"
  else
    container="agentbrowse-kernel-live-view-${name}"
  fi
  mkdir -p "$RUNTIME_DIR"
  chmod 700 "$RUNTIME_DIR"
  local path
  path="$(config_path "$name")"
  {
    printf 'NAME=%q\n' "$name"
    printf 'SLOT=%q\n' "$slot"
    printf 'CONTAINER=%q\n' "$container"
    printf 'HTTP_PORT=%q\n' "$((18080 + 10#$slot))"
    printf 'WEBRTC_PORT=%q\n' "$((56000 + 10#$slot))"
  } >"$path"
  chmod 600 "$path"
}

load_config() {
  local name="$1" path
  path="$(config_path "$name")"
  if [[ ! -f "$path" && "$name" == local ]]; then
    write_config local 0
  fi
  [[ -f "$path" ]] || die "unknown target '$name'; run 'tools/live-view start $name SLOT' first"
  # The file is generated by this tool from validated values and is owned mode 0600.
  # This tool generated the validated, mode-0600 file.
  # shellcheck disable=SC1090
  source "$path"
}

tailnet_ip() {
  if [[ -n "${AGENTBROWSE_ARTBIRD_IP:-}" ]]; then
    printf '%s\n' "$AGENTBROWSE_ARTBIRD_IP"
    return
  fi
  local detected
  detected="$(ssh -o BatchMode=yes "$REMOTE_HOST" 'tailscale ip -4' | sed -n '1p')"
  [[ "$detected" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
    die "could not resolve artbird's Tailnet IPv4 address"
  printf '%s\n' "$detected"
}

image_ref() {
  [[ -d "$SOURCE_DIR/.git" ]] || die "kernel-images checkout not found at $SOURCE_DIR"
  printf 'agentbrowse/kernel-headful:%s\n' "$(git -C "$SOURCE_DIR" rev-parse --short=12 HEAD)"
}

container_exists() {
  docker --context "$DOCKER_CONTEXT" container inspect "$CONTAINER" >/dev/null 2>&1
}

container_running() {
  [[ "$(docker --context "$DOCKER_CONTEXT" container inspect --format '{{.State.Running}}' "$CONTAINER" 2>/dev/null)" == true ]]
}

verify_container_config() {
  local remote_ip="$1" image="$2" env http_bind webrtc_bind
  [[ "$(docker --context "$DOCKER_CONTEXT" container inspect --format '{{.Config.Image}}' "$CONTAINER")" == "$image" ]] ||
    die "$CONTAINER uses a different image; remove it explicitly before recreating it"
  env="$(docker --context "$DOCKER_CONTEXT" container inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$CONTAINER")"
  grep -Fxq 'ENABLE_WEBRTC=true' <<<"$env" ||
    die "$CONTAINER does not enable WebRTC; remove it explicitly before recreating it"
  grep -Fxq "NEKO_WEBRTC_UDPMUX=$WEBRTC_PORT" <<<"$env" ||
    die "$CONTAINER uses a different WebRTC mux port; remove it explicitly before recreating it"
  grep -Fxq "NEKO_WEBRTC_NAT1TO1=$remote_ip" <<<"$env" ||
    die "$CONTAINER uses a different WebRTC NAT address; remove it explicitly before recreating it"
  http_bind="$(docker --context "$DOCKER_CONTEXT" port "$CONTAINER" 8080/tcp)"
  [[ "$http_bind" == "127.0.0.1:${HTTP_PORT}" ]] ||
    die "$CONTAINER uses a different loopback HTTP port; remove it explicitly before recreating it"
  webrtc_bind="$(docker --context "$DOCKER_CONTEXT" port "$CONTAINER" "${WEBRTC_PORT}/udp")"
  [[ "$webrtc_bind" == "${remote_ip}:${WEBRTC_PORT}" ]] ||
    die "$CONTAINER uses a different Tailnet WebRTC port; remove it explicitly before recreating it"
}

wait_ready() {
  printf 'Waiting for %s\n' "$CONTAINER"
  for ((attempt = 1; attempt <= 120; attempt++)); do
    if docker --context "$DOCKER_CONTEXT" exec "$CONTAINER" \
      curl --fail --silent --connect-timeout 2 --max-time 3 \
      http://127.0.0.1:8080/ >/dev/null 2>&1; then
      printf '%s is ready\n' "$CONTAINER"
      return
    fi
    sleep 1
  done
  die "$CONTAINER did not become ready within 120 seconds"
}

start_target() {
  local name="$1" slot="$2" remote_ip image
  validate_name "$name"
  validate_slot "$slot"
  write_config "$name" "$slot"
  load_config "$name"
  remote_ip="$(tailnet_ip)"
  image="$(image_ref)"

  if container_exists; then
    verify_container_config "$remote_ip" "$image"
    if container_running; then
      printf '%s is already running\n' "$CONTAINER"
    else
      docker --context "$DOCKER_CONTEXT" start "$CONTAINER" >/dev/null
    fi
    wait_ready
    return
  fi

  docker --context "$DOCKER_CONTEXT" image inspect "$image" >/dev/null 2>&1 ||
    die "image $image is not present on $REMOTE_HOST"
  docker --context "$DOCKER_CONTEXT" run --detach \
    --name "$CONTAINER" \
    --label dev.agentbrowse.role=kernel-live-view \
    --label "dev.agentbrowse.target=$name" \
    --platform linux/amd64 \
    --privileged \
    --tmpfs /dev/shm:rw,size=2g \
    --memory 8g \
    --publish "127.0.0.1:${HTTP_PORT}:8080" \
    --publish "${remote_ip}:${WEBRTC_PORT}:${WEBRTC_PORT}/udp" \
    --env DISPLAY_NUM=1 \
    --env HEIGHT=1080 \
    --env WIDTH=1920 \
    --env TZ=America/New_York \
    --env RUN_AS_ROOT=false \
    --env ENABLE_WEBRTC=true \
    --env "NEKO_WEBRTC_UDPMUX=$WEBRTC_PORT" \
    --env "NEKO_WEBRTC_NAT1TO1=$remote_ip" \
    --env "NEKO_LOG_LEVEL=$NEKO_LOG_LEVEL" \
    "$image" >/dev/null
  wait_ready
}

show_status() {
  load_config "$1"
  if ! container_exists; then
    printf '%s does not exist\n' "$CONTAINER"
    return
  fi
  docker --context "$DOCKER_CONTEXT" ps --all \
    --filter "name=^/${CONTAINER}$" \
    --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}'
  if container_running; then
    docker --context "$DOCKER_CONTEXT" exec "$CONTAINER" \
      supervisorctl -c /etc/supervisor/supervisord.conf status \
      xorg mutter chromium neko kernel-images-api
  fi
}

open_tunnel() {
  load_config "$1"
  printf 'Forwarding http://127.0.0.1:%s to %s through %s\n' "$HTTP_PORT" "$CONTAINER" "$REMOTE_HOST"
  printf 'Keep this command running; press Ctrl-C to close the tunnel.\n'
  exec ssh -N \
    -o BatchMode=yes \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=30 \
    -L "127.0.0.1:${HTTP_PORT}:127.0.0.1:${HTTP_PORT}" \
    "$REMOTE_HOST"
}

emit_descriptor() {
  load_config "$1"
  printf '{"version":1,"label":"artbird/%s","base_url":"http://127.0.0.1:%s","username":"kernel","password":"admin","read_only":false}\n' \
    "$NAME" "$HTTP_PORT"
}

launch_target() {
  load_config "$1"
  [[ -x "$APP_EXECUTABLE" ]] || die "app is not built; run 'tools/fetch-webrtc && zig build'"
  curl --fail --silent --connect-timeout 2 --max-time 3 \
    "http://127.0.0.1:${HTTP_PORT}/" >/dev/null ||
    die "tunnel is unavailable; run 'tools/live-view tunnel $NAME' in another terminal"
  emit_descriptor "$NAME" | "$APP_EXECUTABLE" --connection-stdin
}

stop_target() {
  load_config "$1"
  if container_running; then
    docker --context "$DOCKER_CONTEXT" stop "$CONTAINER" >/dev/null
    printf 'Stopped %s; the container and image were preserved\n' "$CONTAINER"
  else
    printf '%s is already stopped or absent\n' "$CONTAINER"
  fi
}

destroy_target() {
  local path
  load_config "$1"
  path="$(config_path "$1")"
  if container_exists; then
    docker --context "$DOCKER_CONTEXT" rm --force "$CONTAINER" >/dev/null
    printf 'Deleted %s; its pinned image was preserved\n' "$CONTAINER"
  else
    printf '%s was already absent\n' "$CONTAINER"
  fi
  rm -f -- "$path"
}

command_name="${1:-}"
target_name="${2:-local}"
case "$command_name" in
  start) start_target "$target_name" "${3:-0}" ;;
  status) validate_name "$target_name"; show_status "$target_name" ;;
  tunnel) validate_name "$target_name"; open_tunnel "$target_name" ;;
  descriptor) validate_name "$target_name"; emit_descriptor "$target_name" ;;
  launch) validate_name "$target_name"; launch_target "$target_name" ;;
  stop) validate_name "$target_name"; stop_target "$target_name" ;;
  destroy) validate_name "$target_name"; destroy_target "$target_name" ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
